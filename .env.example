# === Database ===
DATABASE_URL=postgresql://lenny_app:lenny_secret@localhost:5432/lenny_growth
POSTGRES_USER=lenny_app
POSTGRES_PASSWORD=lenny_secret
POSTGRES_DB=lenny_growth

# === Embedding ===
# Model name for sentence-transformers (also written to corpus_metadata at ingest time)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# === LLM Providers (used in Step 3+) ===
DEFAULT_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# === App ===
LOG_LEVEL=INFO
